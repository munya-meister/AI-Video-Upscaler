# Copy to .env on the GPU host. Never commit real secrets.
VIDEL_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VIDEL_CORS_ORIGINS=https://YOUR-VIDEL-SITE.vercel.app
VIDEL_DATA_DIR=/data/videl
VIDEL_MAX_UPLOAD_MB=250
VIDEL_MAX_DURATION_SECONDS=120
VIDEL_MAX_PIXELS=2073600
VIDEL_FFMPEG=ffmpeg
VIDEL_FFPROBE=ffprobe
VIDEL_REALESRGAN=/opt/realesrgan/realesrgan-ncnn-vulkan
VIDEL_MODEL_DIR=/opt/realesrgan/models
VIDEL_TILE=128
